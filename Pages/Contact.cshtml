@page
@model ContactModel
@{
    ViewData["Title"] = "contact page";
}
<link rel="stylesheet" href="~/css/firstPage.css" >
<link rel="stylesheet" href="~/css/secondPage.css" >
<link rel="stylesheet" href="~/css/thirdPage.css" >


<div class="imgback">
    <br>
    <!--This is the contact form, within are different types of input boxes used to take user information, each has a required lable to ensure the user cannot skip them-->
    <div class="containerbox11">
        <form>
            <label>First name</label>
            <input type="text" required>
            <br >
            <label>Second name</label>
            <input type="text" required >
            <br>
            <label>Email</label>
            <input type="text" required>
            <br>
            <label>time of arrival</label>
            <input type="date" required>
            <br>
            <label>extra info</label>
            <textarea class="asks" name="headsup" cols="38" rows="18"></textarea>
            <br>
            <input type="submit" id="mybutton" value="send messege" >
            <div class="hidden" id="thankyou">
                thank you for your inquriy
                </div>



        </form>
        <!--this is the external contact page contating a map api containted within a section and two text divs for the email and phone number-->
        <div class="rdiv">
            <div class="textforcon"><p>email@gmail.com</p></div>
            <div class="textforcon"><p>2343567241</p></div>


            <section>
                <iframe class="lil" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2382.8764146720405!2d-2.700322024524454!3d53.32756607228384!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487ae2dd5210777f%3A0x43a4e06029a19d8c!2sRuncorn%20Shopping%20City!5e0!3m2!1sen!2suk!4v1769429707810!5m2!1sen!2suk" width="auto" height="auto" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </section>
        </div>
    </div>

</div>

<script src="~/js/thankpopup.js"></script>
