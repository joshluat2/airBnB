                    <th>3RD</th>
                    <th>4th</th>
                    <th>5th</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tblRoomBookings in Model.RoomBooking)
                {
                    <tr>
                        <td>@tblRoomBookings.Id</td>
                        <td>@tblRoomBookings.room_name</td>
                        <td>@tblRoomBookings.room_desc</td>
                        <td>@tblRoomBookings.price_per_night</td>
                        <td><img src="@string.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(tblRoomBookings.image_data))" alt="Images from a database showing the kitchen, livingroom and bedroom, more can be seen below"/></td>

