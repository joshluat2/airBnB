@page
@model airBnB.Pages.Booking.CreateModel

        @{
        ViewData["Title"] = "Create";
        }
        
        <h1>Create</h1>
        
    <h4>RoomBooking</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RoomBooking.room_name" class="control-label"></label>
                <input asp-for="RoomBooking.room_name" class="form-control" />
                <span asp-validation-for="RoomBooking.room_name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomBooking.room_desc" class="control-label"></label>
                <input asp-for="RoomBooking.room_desc" class="form-control" />
                <span asp-validation-for="RoomBooking.room_desc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomBooking.price_per_night" class="control-label"></label>
                <input asp-for="RoomBooking.price_per_night" class="form-control" />
                <span asp-validation-for="RoomBooking.price_per_night" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomBooking.image_desc" class="control-label"></label>
                <input asp-for="RoomBooking.image_desc" class="form-control" />
                <span asp-validation-for="RoomBooking.image_desc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomBooking.image_data" class="control-label"></label>
                <input asp-for="RoomBooking.image_data" class="form-control" />
                <span asp-validation-for="RoomBooking.image_data" class="text-danger"></span>

                <input type="file" id="file1"
                    name="file1"
					   multiple="multiple" />

            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
